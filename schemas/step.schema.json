{
  "$defs": {
    "StepStatus": {
      "description": "Fine-grained unit status inside one attempt.",
      "enum": [
        "PENDING",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED",
        "SKIPPED"
      ],
      "title": "StepStatus",
      "type": "string"
    }
  },
  "description": "One planner/controller step inside an attempt.",
  "properties": {
    "attempt_id": {
      "title": "Attempt Id",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "objective": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Objective"
    },
    "schema_version": {
      "default": "step.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/StepStatus"
    },
    "step_id": {
      "title": "Step Id",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "step_id",
    "task_id",
    "attempt_id",
    "status"
  ],
  "title": "Step",
  "type": "object"
}
